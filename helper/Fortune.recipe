from calibre.web.feeds.recipes import BasicNewsRecipe
import json
import re


def classes(classes):
    q = frozenset(classes.split(' '))
    return dict(attrs={'class': lambda x: x and frozenset(x.split()).intersection(q)})


class Fortune(BasicNewsRecipe):
    title = 'Fortune Magazine'
    __author__ = 'Rick Shang'
    description = 'FORTUNE is a global business magazine.'
    language = 'en'
    category = 'news'
    encoding = 'UTF-8'

    no_javascript = True
    no_stylesheets = True
    needs_subscription = 'optional'
    delay = 2
    remove_attributes = ['style', 'height', 'width', 'data-*']
    remove_empty_feeds = True

    # ===== 只保留文章核心内容 =====
    keep_only_tags = [
        dict(name='article'),
        dict(name='h1'),
        dict(name='h2'),
        dict(name='h3'),
        dict(name='h4'),
        dict(name='p'),
        dict(name='img'),
        dict(name='figure'),
        dict(name='figcaption'),
        dict(name='blockquote'),
        dict(attrs={'class': 'wp-block-paragraph'}),
        dict(attrs={'class': lambda x: x and 'article-content' in x}),
        # 作者和日期信息
        dict(attrs={'data-cy': 'article-author-and-date'}),
        dict(attrs={'data-cy': 'feature-byline-publish-date'}),
        dict(attrs={'data-cy': 'article-title'}),
        dict(attrs={'data-cy': 'article-eyebrow'}),
        dict(attrs={'data-cy': 'article-authors'}),
        dict(attrs={'data-cy': 'author-name'}),
        dict(attrs={'data-cy': 'author-role'}),
    ]

    # ===== 彻底移除所有垃圾内容 =====
    remove_tags = [
        # 脚本和样式
        dict(name=['script', 'style', 'noscript', 'iframe', 'svg', 'path', 'template', 'source']),
        # 广告和推广
        dict(attrs={'class': lambda x: x and any(
            keyword in x.lower() for keyword in 
            ['ad', 'promo', 'social', 'share', 'related', 'sidebar', 'nav', 'footer', 
             'header', 'trending', 'most-popular', 'recirc', 'newsletter', 'subscribe',
             'pagination', 'breadcrumb', 'hero', 'banner', 'modal', 'cookie', 'trending',
             'popular', 'recommend', 'video', 'playlist', 'carousel', 'slider']
        )}),
        dict(attrs={'id': lambda x: x and any(
            keyword in x.lower() for keyword in 
            ['ad', 'promo', 'social', 'share', 'related', 'sidebar', 'nav', 'footer',
             'trending', 'popular', 'recirc', 'video', 'playlist']
        )}),
        dict(attrs={'data-cy': lambda x: x and any(
            keyword in x.lower() for keyword in
            ['ad', 'promo', 'social', 'share', 'related', 'sidebar', 'nav', 'footer',
             'trending', 'popular', 'recirc', 'header', 'breadcrumb', 'video']
        )}),
        # 交互元素
        dict(name='div', attrs={'role': 'button'}),
        dict(attrs={'data-empty': 'true'}),
        dict(attrs={'aria-hidden': 'true'}),
        dict(attrs={'hidden': ''}),
        dict(name='hr'),
        dict(name='button'),
        dict(name='input'),
        dict(name='form'),
        # 分页和数字
        dict(attrs={'class': lambda x: x and 'pagination' in x.lower()}),
        dict(attrs={'data-cy': 'pagination'}),
    ]

    recipe_specific_options = {
        'issue_url': {
            'short': 'Custom magazine archive URL',
            'default': '',
        },
    }

    extra_css = '''
        body { 
            font-family: Georgia, "Times New Roman", serif; 
            font-size: 14px; 
