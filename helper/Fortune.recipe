from calibre.web.feeds.recipes import BasicNewsRecipe
import json
import re


def classes(classes):
    q = frozenset(classes.split(' '))
    return dict(attrs={'class': lambda x: x and frozenset(x.split()).intersection(q)})


def prefix_classes(classes):
    q = classes.split()

    def test(x):
        if x:
            for cls in x.split():
                for c in q:
                    if cls.startswith(c):
                        return True
        return False

    return dict(attrs={'class': test})


class Fortune(BasicNewsRecipe):
    title = 'Fortune Magazine'
    __author__ = 'Rick Shang'

    description = 'FORTUNE is a global business magazine that has been revered in its content and credibility since 1930.'
    language = 'en'
    category = 'news'
    encoding = 'UTF-8'

    no_javascript = True
    no_stylesheets = True
    needs_subscription = 'optional'

    delay = 2
    remove_attributes = ['style', 'height', 'width']
    remove_empty_feeds = True

    # ===== 文章过滤：只保留主要内容 =====
    keep_only_tags = [
        dict(name='article'),
        classes('article-content'),
        classes('wp-block-paragraph'),
        dict(name='h1'),
        dict(name='h2'),
        dict(name='h3'),
        dict(name='h4'),
        dict(name='p'),
        dict(name='blockquote'),
        dict(name='ul'),
        dict(name='ol'),
        dict(name='li'),
        dict(name='figure'),      # ← 保留图片容器
        dict(name='figcaption'),  # ← 保留图片说明
        dict(name='img'),
    ]

    # ===== 移除所有不需要的内容 =====
    remove_tags = [
        dict(name=['script', 'style', 'noscript', 'iframe', 'svg', 'path']),
        dict(attrs={'class': lambda x: x and any(
            keyword in x.lower() for keyword in 
            ['ad', 'promo', 'social', 'share', 'related', 'sidebar', 'nav', 'footer', 
             'header', 'trending', 'most-popular', 'recirc', 'newsletter', 'subscribe',
             'pagination', 'breadcrumb', 'hero', 'banner', 'modal']
        )}),
        dict(attrs={'id': lambda x: x and any(
            keyword in x.lower() for keyword in 
            ['ad', 'promo', 'social', 'share', 'related', 'sidebar', 'nav', 'footer',
             'trending', 'popular', 'recirc']
        )}),
        dict(attrs={'data-cy': lambda x: x and any(
            keyword in x.lower() for keyword in
            ['ad', 'promo', 'social', 'share', 'related', 'sidebar', 'nav', 'footer',
             'trending', 'popular', 'recirc', 'header', 'breadcrumb']
        )}),
        dict(name='template'),
        dict(name='hr'),
        dict(name='div', attrs={'role': 'button'}),
        dict(attrs={'data-empty': 'true'}),
        dict(attrs={'aria-hidden': 'true'}),
        dict(attrs={'hidden': ''}),
        dict(attrs={'style': lambda x: x and 'display:none' in x.lower()}),
    ]

    # ===== 添加 recipe_specific_options =====
    recipe_specific_options = {
        'issue_url': {
            'short': 'Custom magazine archive URL',
            'long': 'Use a specific URL for the magazine archive page',
            'default': '',
        },
    }

    extra_css = '''
        body { 
